[Unit]
Description=和工作 Agent 运行空间自动协调
After=network-online.target postgresql.service hegongzuo-api.service
Wants=network-online.target
OnFailure=hegongzuo-alert@%n.service

[Service]
Type=oneshot
User=__DEPLOY_USER__
Group=__DEPLOY_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=/usr/bin/env node scripts/reconcile-agent-runtimes.mjs
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# 能力包初始化会更新当前服务账号的 Corepack 元数据；该任务不对外提供服务，
# 因此在此处允许访问服务账号目录，运行中的独立能力服务仍保持 ProtectHome 隔离。
ProtectHome=false
ReadWritePaths=__PROJECT_DIR__/.runtime
