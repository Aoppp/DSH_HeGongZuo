[Unit]
Description=和工作平台 API
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=hegongzuo-alert@%n.service

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=/usr/bin/node apps/api/dist/server.js
Restart=on-failure
RestartSec=5
MemoryMax=1G
CPUQuota=100%
TasksMax=256
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# 新账号初始化会更新当前服务账号的 Corepack 元数据；API 以此完成运行空间安装。
ProtectHome=false
StateDirectory=hegongzuo-wecom
StateDirectoryMode=0700
ReadWritePaths=__PROJECT_DIR__/.runtime /var/lib/hegongzuo-wecom

[Install]
WantedBy=multi-user.target
