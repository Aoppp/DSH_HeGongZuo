# 本文件只能保存变量名和示例，禁止填写或提交真实密钥。
DEEPSEEK_API_KEY=

# 使用兼容 DeepSeek API 的自定义服务时再启用。
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# PostgreSQL 员工数据库。请按实际账号、密码、主机和数据库名修改。
DATABASE_URL=postgresql://hegongzuo:change_me@127.0.0.1:5432/hegongzuo

# 云数据库要求 TLS 时设置为 require；本地开发保持 disable。
DATABASE_SSL=disable

# 和工作员工 API 本地监听配置。
HEGONGZUO_API_HOST=127.0.0.1
HEGONGZUO_API_PORT=4174

# 生产环境启用 HTTPS 后设为 true，使登录会话 Cookie 仅通过 HTTPS 传输。
HEGONGZUO_SESSION_COOKIE_SECURE=false

# 企业微信智能表格工作日报（非密钥）。授权信息由 wecom-cli 自身加密保存。
WECOM_WORK_DAILY_DOC_ID=
WECOM_WORK_DAILY_SHEET_ID=
WECOM_CLI_PATH=/usr/bin/wecom-cli
# 生产环境由 systemd path 监听该文件，网页手动同步只写入触发标记。
WECOM_WORK_DAILY_SYNC_REQUEST_PATH=/var/lib/hegongzuo-wecom/manual-sync.request

# 企业微信打卡接口。CorpID 复用已有 HEGONGZUO_WECOM_CORP_ID；仅在生产 .env 填写真实 Secret。
HEGONGZUO_WECOM_CORP_ID=
HEGONGZUO_WECOM_CHECKIN_SECRET=
 # 可选：生产故障告警 Webhook，不要提交真实地址或凭据。
HEGONGZUO_ALERT_WEBHOOK_URL=
