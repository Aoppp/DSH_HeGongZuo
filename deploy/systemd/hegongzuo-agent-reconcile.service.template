[Unit]
Description=和工作 Agent 运行空间自动协调
After=network-online.target postgresql.service hegongzuo-api.service
Wants=network-online.target
OnFailure=hegongzuo-alert@%n.service

[Service]
Type=oneshot
User=__DEPLOY_USER__
Group=__DEPLOY_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=/usr/bin/env node scripts/reconcile-agent-runtimes.mjs
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
BindReadOnlyPaths=/home/__DEPLOY_USER__/.cache/node/corepack
ReadWritePaths=__PROJECT_DIR__/.runtime
