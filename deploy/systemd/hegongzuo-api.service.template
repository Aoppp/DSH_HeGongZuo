[Unit]
Description=和工作平台 API
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=hegongzuo-alert@%n.service

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=/usr/bin/node apps/api/dist/server.js
Restart=on-failure
RestartSec=5
MemoryMax=1G
CPUQuota=100%
TasksMax=256
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__PROJECT_DIR__/.runtime

[Install]
WantedBy=multi-user.target
