#!/bin/sh
# 此文件安装到 /usr/local/sbin 并由 root 所有；只接受严格校验后的账号 ID。
set -eu

PROJECT_DIR=__PROJECT_DIR__
DEPLOY_USER=__DEPLOY_USER__
CONFIG_PATH="$PROJECT_DIR/.runtime/agent-runtimes.json"
RESTART_REQUEST_PATH="$PROJECT_DIR/.runtime/agent-restart-request"
ACTIVATION_REQUEST_PATH="$PROJECT_DIR/.runtime/agent-activation-request"
ACTIVITY_DIR="$PROJECT_DIR/.runtime/agent-activity"
IDLE_TIMEOUT_SECONDS=1800

if [ ! -f "$CONFIG_PATH" ]; then
  echo "[和工作] 运行时配置不存在：$CONFIG_PATH" >&2
  exit 1
fi

desired_runtimes=$(/usr/bin/node -e '
  const fs = require("node:fs")
  const entries = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
  if (!Array.isArray(entries)) throw new Error("运行时配置必须为数组")
  const ids = [...new Set(entries.map((entry) => entry?.runtimeId).filter((id) => typeof id === "string" && /^[a-z][a-z0-9-]{1,62}--[a-z][a-z0-9]{1,31}$/.test(id)))]
  if (ids.length !== entries.length) throw new Error("运行时配置包含无效账号")
  process.stdout.write(ids.join("\n"))
' "$CONFIG_PATH")

running_runtimes=$(systemctl list-units --all --no-legend 'hegongzuo-agent@*.service' | sed -n 's/^[[:space:]]*hegongzuo-agent@\([a-z][a-z0-9-]*--[a-z][a-z0-9]*\)\.service.*/\1/p')
legacy_accounts=$(systemctl list-units --all --no-legend 'hegongzuo-agent@*.service' | sed -n 's/^[[:space:]]*hegongzuo-agent@\([a-z][a-z0-9]*\)\.service.*/\1/p')
restart_runtimes=""
activation_runtimes=""
restart_processing="${RESTART_REQUEST_PATH}.processing.$$"
activation_processing="${ACTIVATION_REQUEST_PATH}.processing.$$"
restore_requests() {
  if [ -f "$restart_processing" ]; then cat "$restart_processing" >> "$RESTART_REQUEST_PATH"; rm -f "$restart_processing"; fi
  if [ -f "$activation_processing" ]; then cat "$activation_processing" >> "$ACTIVATION_REQUEST_PATH"; rm -f "$activation_processing"; fi
}
trap restore_requests EXIT HUP INT TERM
if [ -f "$RESTART_REQUEST_PATH" ]; then mv "$RESTART_REQUEST_PATH" "$restart_processing"; fi
if [ -f "$ACTIVATION_REQUEST_PATH" ]; then mv "$ACTIVATION_REQUEST_PATH" "$activation_processing"; fi
if [ -f "$restart_processing" ]; then restart_runtimes=$(sed -n 's/^\([a-z][a-z0-9-]*--[a-z][a-z0-9]*\)$/\1/p' "$restart_processing" | sort -u); fi
if [ -f "$activation_processing" ]; then activation_runtimes=$(sed -n 's/^\([a-z][a-z0-9-]*--[a-z][a-z0-9]*\)$/\1/p' "$activation_processing" | sort -u); fi
install -d -o "$DEPLOY_USER" -g "$DEPLOY_USER" "$ACTIVITY_DIR"

# v2.02 之前的实例仅以账号命名；切换为 agent--account 后必须先停用，
# 否则会与新实例争用相同端口。
for account in $legacy_accounts; do
  systemctl disable --now "hegongzuo-agent@${account}.service"
done

for runtime in $running_runtimes; do
  if ! printf '%s\n' "$desired_runtimes" | grep -Fxq "$runtime"; then
    systemctl disable --now "hegongzuo-agent@${runtime}.service"
  fi
done

for runtime in $desired_runtimes; do
  unit="hegongzuo-agent@${runtime}.service"
  # 独立 UID 隔离 /proc 与进程访问；平台组只用于后台管理当前实例的文件。
  runtime_user="hga$(printf '%s' "$runtime" | sha256sum | cut -c1-20)"
  if ! id "$runtime_user" >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin --gid "$DEPLOY_USER" "$runtime_user"
  fi
  unit_directory="/etc/systemd/system/${unit}.d"
  if [ ! -f "$unit_directory/identity.conf" ]; then
    install -d -m 755 "$unit_directory"
    printf '[Service]\nUser=%s\n' "$runtime_user" > "$unit_directory/identity.conf"
    systemctl daemon-reload
  fi
  prepare_sandbox() {
    sandbox="$PROJECT_DIR/.runtime/agent-sandboxes/$runtime"
    if [ ! -d "$sandbox" ] || [ -L "$sandbox" ]; then return 1; fi
    # 不跟随工作区中的符号链接，避免修改工作区外文件的归属。
    chown -hR "$runtime_user:$DEPLOY_USER" "$sandbox"
    find -P "$sandbox" -type d -exec chmod u+rwx,g+rws,o-rwx {} +
    find -P "$sandbox" -type f -exec chmod g+rw,o-rwx {} +
  }
  # 实例只按需启动，禁止随服务器启动而一次性拉起全部账号运行时。
  systemctl disable "$unit" >/dev/null 2>&1 || true
  if systemctl is-active --quiet "$unit"; then
    activity_path="$ACTIVITY_DIR/$runtime"
    if [ ! -f "$activity_path" ]; then
      install -o "$DEPLOY_USER" -g "$DEPLOY_USER" /dev/null "$activity_path"
    fi
    if printf '%s\n' "$restart_runtimes" | grep -Fxq "$runtime"; then
      systemctl stop "$unit"
      prepare_sandbox
      systemctl start "$unit"
    else
      now=$(date +%s)
      modified=$(stat -c %Y "$activity_path")
      if [ $((now - modified)) -gt "$IDLE_TIMEOUT_SECONDS" ]; then
        systemctl stop "$unit"
        echo "[和工作] 空闲运行时已释放：$runtime"
      fi
    fi
  elif printf '%s\n' "$activation_runtimes" | grep -Fxq "$runtime"; then
    prepare_sandbox
    if systemctl start "$unit"; then
      echo "[和工作] 按需启动运行时：$runtime"
    else
      echo "[和工作] 按需启动失败，等待下一次请求重试：$runtime" >&2
    fi
  fi
done

rm -f "$restart_processing" "$activation_processing"
trap - EXIT HUP INT TERM
