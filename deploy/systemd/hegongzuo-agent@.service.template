[Unit]
Description=和工作 Agent 运行时：%i
After=network-online.target hegongzuo-api.service
Wants=network-online.target
OnFailure=hegongzuo-alert@%n.service

[Service]
Type=simple
User=__DEPLOY_USER__
Group=__DEPLOY_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=/usr/bin/env node scripts/run-agent-runtime.mjs %i
Restart=on-failure
RestartSec=5
MemoryMax=1G
CPUQuota=75%
TasksMax=192
LimitNOFILE=32768
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__PROJECT_DIR__/.runtime

[Install]
WantedBy=multi-user.target
