{
  "name": "@hegongzuo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/import-employees.mjs --apply",
    "db:import-departed": "node scripts/import-departed-employees.mjs --apply",
    "db:normalize-departure-reasons": "node scripts/normalize-departure-reasons.mjs",
    "work-reports:import-history": "tsx src/modules/employee/work-reports/sync-cli.ts import-history",
    "work-reports:sync": "tsx src/modules/employee/work-reports/sync-cli.ts sync",
    "checkins:sync": "tsx src/modules/employee/attendance/checkin-sync-cli.ts sync",
    "checkins:history": "tsx src/modules/employee/attendance/checkin-sync-cli.ts history",
    "leaves:sync": "tsx src/modules/employee/attendance/leave-sync-cli.ts sync",
    "leaves:history": "tsx src/modules/employee/attendance/leave-sync-cli.ts history",
    "wecom-directory:sync": "tsx src/modules/employee/attendance/directory-sync-cli.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed && pnpm db:seed:accounts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed:accounts": "node scripts/seed-accounts.mjs"
  },
  "dependencies": {
    "@hegongzuo/employee-domain": "workspace:*",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.12"
  }
}
