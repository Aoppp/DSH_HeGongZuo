[Unit]
Description=同步企业微信工作日报
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=hegongzuo-alert@%n.service

[Service]
Type=oneshot
User=__DEPLOY_USER__
Group=__DEPLOY_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=HOME=/var/lib/hegongzuo-wecom
ExecStartPre=/usr/bin/rm -f /var/lib/hegongzuo-wecom/manual-sync.request
ExecStart=/usr/bin/node apps/api/dist/modules/employee/work-reports/sync-cli.js sync
StateDirectory=hegongzuo-wecom
StateDirectoryMode=0700
TimeoutStartSec=10min
MemoryMax=384M
CPUQuota=50%
TasksMax=128
LimitNOFILE=8192
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hegongzuo-wecom
